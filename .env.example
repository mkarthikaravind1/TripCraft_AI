# Copy to .env for local development. Placeholder values only — never commit real secrets.

# Django
DEBUG=True
SECRET_KEY=replace-with-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated, with scheme. Render's own hostname is added automatically.
CSRF_TRUSTED_ORIGINS=
# Leave unset locally to use SQLite. Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Google Gemini (AI itineraries + support assistant). Without a key the app uses labelled fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=60

# MongoDB (assistant chat logs + feedback). Example: mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=tripcraft
MONGODB_TIMEOUT_MS=2500

# Open-Meteo weather API (no key needed)
WEATHER_TIMEOUT_SECONDS=4

# Rate limits (requests per window, per client IP)
RATE_LIMIT_GENERATE=6
RATE_LIMIT_CHAT=20
